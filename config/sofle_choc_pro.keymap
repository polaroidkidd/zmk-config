#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include "ch-de.h"

#define ROOT            0
#define I3              1
#define SYS             2
#define SYMBL           3
#define NUM             4

/ {

        behaviors {

                n1_plus: number_1_plus {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_N1>, <&kp KP_PLUS>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                n0_grave: number_0_grave {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_N0>, <&kp DE_GRAVE>;
                        mods = <(MOD_RALT)>;
                };

                del_dllr: delete_dollar {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DEL>, <&kp DE_DLLR>;
                        mods = <(MOD_RALT)>;
                };
                
                p_lbrc: p_left_brace {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_P>, <&kp DE_LBRC>;
                        mods = <(MOD_RALT)>;
                };

                // Shift produces a capital umlaut. CH-DE has no direct Shift
                // capital umlaut, so toggle Caps Lock around the umlaut key.
                // (mod-morph masks the triggering Shift, so the macro is clean.)
                ue_cap: ue_capital {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_U_UMLAUT>, <&ue_cap_macro>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                ue_rbrc: ue_right_brace {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&ue_cap>, <&kp DE_RBRC>;
                        mods = <(MOD_RALT)>;
                };

                oe_cap: oe_capital {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_O_UMLAUT>, <&oe_cap_macro>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                oe_lbkt: oe_left_bracket {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&oe_cap>, <&kp DE_LBKT>;
                        mods = <(MOD_RALT)>;
                };

                ae_cap: ae_capital {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_A_UMLAUT>, <&ae_cap_macro>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                ae_rbkt: ae_right_bracket {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&ae_cap>, <&kp DE_RBKT>;
                        mods = <(MOD_RALT)>;
                };

                ton: toggle_layer_on {
                        compatible = "zmk,behavior-toggle-layer";
                        #binding-cells = <1>;
                        toggle-mode = "on";
                };

                toff: toggle_layer_off {
                        compatible = "zmk,behavior-toggle-layer";
                        #binding-cells = <1>;
                        toggle-mode = "off";
                };

                mo_none: momentary_layer_no_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&mo>, <&none>;
                };

                num_td: number_layer_tap_dance {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <200>;
                        bindings = <&mo_none NUM 0>, <&ton NUM>;
                };

        };

        macros {
                ue_cap_macro: ue_cap_macro {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp CAPS>, <&kp DE_U_UMLAUT>, <&kp CAPS>;
                };

                oe_cap_macro: oe_cap_macro {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp CAPS>, <&kp DE_O_UMLAUT>, <&kp CAPS>;
                };

                ae_cap_macro: ae_cap_macro {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp CAPS>, <&kp DE_A_UMLAUT>, <&kp CAPS>;
                };

                num_esc: number_layer_escape {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp ESC>, <&toff NUM>;
                };

                i3_gui: i3_gui {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        wait-ms = <0>;
                        tap-ms = <0>;
                        bindings = <&macro_press &mo I3 &kp LGUI>, <&macro_pause_for_release>, <&macro_release &kp LGUI &mo I3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                root_layer {
                        display-name = "ROOT";
                        bindings = <
        &kp ESC      &n1_plus          &kp DE_N2         &kp DE_N3         &kp DE_N4         &kp DE_N5                                            &kp DE_N6        &kp DE_N7       &kp DE_N8         &kp DE_N9          &n0_grave           &del_dllr
        &kp TAB      &kp DE_Q          &kp DE_W          &kp DE_E          &kp DE_R          &kp DE_T                                             &kp DE_Z         &kp DE_U        &kp DE_I          &kp DE_O           &p_lbrc             &ue_rbrc
        &kp LSHFT    &kp DE_A          &kp DE_S          &kp DE_D          &kp DE_F          &kp DE_G                                             &kp DE_H         &kp DE_J        &kp DE_K          &kp DE_L           &oe_lbkt            &ae_rbkt
        &kp LCTRL    &kp DE_Y          &kp DE_X          &kp DE_C          &kp DE_V          &kp DE_B         &kp DE_LT          &kp DE_SQT       &kp DE_N         &kp DE_M        &kp DE_COMMA      &kp DE_DOT         &kp DE_MINUS        &kp RET
                                       &mo NUM           &mo SYS           &kp LALT          &i3_gui          &kp SPACE          &kp BACKSPACE    &mo SYMBL        &kp RALT        &kp RCTRL         &num_td
                        >;
                };

                i3_layer {
                        display-name = "I3";
                        bindings = <
        &kp LG(ESC)  &kp LG(N1)        &kp LG(N2)        &kp LG(N3)        &kp LG(N4)        &kp LG(N5)                                            &kp LG(N6)       &kp LG(N7)      &kp LG(N8)        &kp LG(N9)         &kp LG(N0)           &trans
        &kp LG(TAB)  &kp LG(Q)         &kp LG(W)         &kp LG(E)         &kp LG(R)         &kp LG(T)                                             &kp LG(DE_Z)     &trans          &kp LG(I)         &trans             &kp LG(P)            &trans
        &trans       &kp LG(LC(A))     &kp LG(S)         &kp LG(LC(S))     &kp LG(F)         &kp LG(DE_MINUS)                                      &kp LG(H)        &kp LG(J)       &kp LG(UP)        &kp LG(L)          &kp LG(A)            &kp LG(D)
        &trans       &kp LG(DE_Y)      &kp LG(DE_DOT)    &kp LG(DE_C)      &kp LG(E)         &kp LG(V)         &kp LG(DE_COMMA)   &kp DE_TILDE     &kp LG(N)        &kp LG(LEFT)    &kp LG(DOWN)      &kp LG(RIGHT)      &kp LG(DE_MINUS)     &kp LG(RET)
                                       &trans            &trans            &kp LG(BACKSPACE) &none             &kp LG(LS(SPACE))  &kp BACKSPACE    &none            &none           &trans            &trans
                        >;
                };

                system_layer {
                        display-name = "SYSTEM";
                        bindings = <
        &kp ESC      &kp F1            &kp F2            &kp F3            &kp F4            &kp F5                                                &kp F6           &kp F7          &kp F8            &kp F9             &kp F10              &kp F12
        &trans       &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4                                          &trans           &trans          &trans            &trans             &kp DE_LBRC          &kp DE_RBRC
        &trans       &rgb_ug RGB_HUD   &rgb_ug RGB_HUI   &rgb_ug RGB_SAD   &rgb_ug RGB_SAI   &rgb_ug RGB_EFF                                       &trans           &trans          &trans            &trans             &kp DE_LBKT          &kp DE_RBKT
        &trans       &rgb_ug RGB_BRD   &rgb_ug RGB_BRI   &rgb_ug RGB_ON    &rgb_ug RGB_OFF   &studio_unlock    &bt BT_CLR         &kp DE_CARET     &trans           &trans          &trans            &trans             &trans               &trans
                                       &trans            &trans            &kp RALT          &none             &trans             &trans           &trans           &trans          &trans            &trans
                        >;
                };

                symbol_layer {
                        display-name = "SYMBL";
                        bindings = <
                
        &trans       &kp RA(DE_N1)     &kp RA(DE_N2)     &kp RA(DE_N3)     &trans            &trans                                                &trans           &kp DE_BSLH     &trans            &trans             &kp DE_QMARK         &kp DE_EXCL
        &trans       &trans            &trans            &trans            &trans            &trans                                                &trans           &trans          &trans            &trans             &trans               &kp PG_UP
        &trans       &trans            &trans            &trans            &trans            &trans                                                &trans           &kp HOME        &kp UP            &kp END            &trans               &kp PG_DN
        &trans       &trans            &trans            &trans            &trans            &trans            &kp DE_GT          &kp DE_CARET     &trans           &kp LEFT        &kp DOWN          &kp RIGHT          &kp DE_UNDER         &kp K_APP
                                       &trans            &trans            &kp LALT          &none             &trans             &trans           &trans           &trans          &trans            &trans
                        >;
                };

                number_layer {
                        display-name = "NUM";
                        bindings = <
        &num_esc     &trans            &trans            &trans            &trans            &trans                                                &trans           &trans          &trans            &trans             &kp DE_GRAVE         &kp DE_DLLR
        &trans       &trans            &trans            &trans            &trans            &trans                                                &trans           &trans          &trans            &kp DE_N7          &kp DE_N8            &kp DE_N9
        &trans       &trans            &trans            &trans            &trans            &trans                                                &trans           &trans          &trans            &kp DE_N4          &kp DE_N5            &kp DE_N6
        &trans       &trans            &trans            &trans            &trans            &trans            &trans             &num_esc         &trans           &trans          &trans            &kp DE_N1          &kp DE_N2            &kp DE_N3
                                       &trans            &trans            &kp RALT          &none             &trans             &trans           &trans           &trans          &kp DE_N0         &trans
                        >;
                };




        };
};
