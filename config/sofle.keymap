#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/rgb.h>


#include "ch-de.h"

#define BASE  0
#define NUM   1
#define SYMBL 2
#define SYS   3

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";

                system_layer {
                        if-layers = <NUM SYMBL>;
                        then-layer = <SYS>;
                };
        };

        behaviors {
                lt_gt: less_greater {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_LT>, <&kp DE_GT>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                tld_crt: tilde_caret {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_TILDE>, <&kp DE_CARET>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                dllr_excl: dollar_exclamation {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_DLLR>, <&kp DE_EXCL>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                p_lbkt: p_left_bracket {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_P>, <&kp DE_U_UMLAUT>;
                        mods = <(MOD_RALT)>;
                };

                ue_rbkt: ue_right_bracket {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_U_UMLAUT>, <&kp DE_UMLAUT>;
                        mods = <(MOD_RALT)>;
                };

                oe_lbrc: oe_left_brace {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_O_UMLAUT>, <&kp DE_A_UMLAUT>;
                        mods = <(MOD_RALT)>;
                };

                ae_rbrc: ae_right_brace {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DE_A_UMLAUT>, <&kp DE_DLLR>;
                        mods = <(MOD_RALT)>;
                };

                ton: toggle_layer_on {
                        compatible = "zmk,behavior-toggle-layer";
                        #binding-cells = <1>;
                        toggle-mode = "on";
                };

                toff: toggle_layer_off {
                        compatible = "zmk,behavior-toggle-layer";
                        #binding-cells = <1>;
                        toggle-mode = "off";
                };

                mo_none: momentary_layer_no_tap {
                        compatible = "zmk,behavior-hold-tap";
                        #binding-cells = <2>;
                        flavor = "hold-preferred";
                        tapping-term-ms = <200>;
                        bindings = <&mo>, <&none>;
                };

                num_td: number_layer_tap_dance {
                        compatible = "zmk,behavior-tap-dance";
                        #binding-cells = <0>;
                        tapping-term-ms = <200>;
                        bindings = <&mo_none NUM 0>, <&ton NUM>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "BASE";
                        bindings = <
        &kp ESC      &kp DE_N1         &kp DE_N2         &kp DE_N3         &kp DE_N4         &kp DE_N5                                           &kp DE_N6        &kp DE_N7       &kp DE_N8         &kp DE_N9          &kp DE_N0           &kp DEL
        &kp TAB      &kp DE_Q          &kp DE_W          &kp DE_E          &kp DE_R          &kp DE_T                                            &kp DE_Z         &kp DE_U        &kp DE_I          &kp DE_O           &p_lbkt             &ue_rbkt
        &kp LSHFT    &kp DE_A          &kp DE_S          &kp DE_D          &kp DE_F          &kp DE_G                                            &kp DE_H         &kp DE_J        &kp DE_K          &kp DE_L           &oe_lbrc            &ae_rbrc
        &kp LCTRL    &kp DE_Y          &kp DE_X          &kp DE_C          &kp DE_V          &kp DE_B         &kp DE_SQT         &lt_gt          &kp DE_N         &kp DE_M        &kp DE_COMMA      &kp DE_DOT         &kp DE_MINUS        &kp RET
                                       &kp LALT          &kp LGUI          &none             &none            &kp SPACE          &kp BACKSPACE   &mo SYMBL        &num_td         &kp RALT          &kp DE_CARET
                        >;
                };

                number_layer {
                        display-name = "NUM";
                        bindings = <
        &toff NUM    &trans            &trans            &trans            &trans            &trans                                               &trans           &trans          &trans            &trans             &kp DE_GRAVE         &kp DE_DLLR
        &trans       &trans            &trans            &trans            &trans            &trans                                               &trans           &trans          &trans            &kp DE_N7          &kp DE_N8            &kp DE_N9
        &trans       &trans            &trans            &trans            &trans            &trans                                               &trans           &trans          &trans            &kp DE_N4          &kp DE_N5            &kp DE_N6
        &trans       &trans            &trans            &trans            &trans            &trans            &kp DE_CARET       &trans          &trans           &trans          &trans            &kp DE_N1          &kp DE_N2            &kp DE_N3
                                       &trans            &trans            &none             &none             &trans             &trans          &trans           &trans          &trans            &kp DE_N0
                        >; 
                };

                symbol_layer {
                        display-name = "SYMBL";
                        bindings = <
        &trans       &trans            &trans            &trans            &trans            &trans                                               &trans           &kp DE_BSLH     &trans            &trans             &kp DE_QMARK         &kp DE_EXCL
        &trans       &trans            &trans            &trans            &trans            &trans                                               &trans           &trans          &trans            &trans             &trans               &kp PG_UP
        &trans       &trans            &trans            &trans            &trans            &trans                                               &trans           &kp HOME        &kp UP            &kp END            &trans               &kp PG_DN
        &trans       &trans            &trans            &trans            &trans            &trans            &kp DE_TILDE       &trans          &trans           &kp LEFT        &kp DOWN          &kp RIGHT          &kp DE_UNDER         &trans
                                       &trans            &trans            &none             &none             &trans             &trans          &trans           &trans          &trans            &trans
                        >;
                };

                system_layer {
                        display-name = "SYS";
                        bindings = <
        &kp F1       &kp F2            &kp F3            &kp F4            &kp F5            &kp F6                                               &kp F7           &kp F8          &kp F9            &kp F10            &kp F11              &kp F12
        &bt BT_CLR   &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_SEL 4                                         &trans           &trans          &trans            &trans             &trans               &trans
        &trans       &rgb_ug RGB_HUD   &rgb_ug RGB_HUI   &rgb_ug RGB_SAD   &rgb_ug RGB_SAI   &rgb_ug RGB_EFF                                      &trans           &kp LEFT        &kp DOWN          &kp RIGHT          &trans               &trans
        &trans       &rgb_ug RGB_BRD   &rgb_ug RGB_BRI   &none             &none             &studio_unlock    &none              &none           &trans           &trans          &trans            &trans             &trans               &trans
                                       &trans            &trans            &none             &none             &trans             &trans          &trans           &trans          &trans            &trans
                        >;
                };
        };
};
